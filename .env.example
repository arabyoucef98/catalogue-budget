# Copy to .env and replace every placeholder with a strong private value.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_INITIAL_ADMIN_PASSWORD

# Keep the API on localhost for one-machine use. Set 0.0.0.0 only for trusted LAN clients.
API_BIND_ADDRESS=127.0.0.1
API_PORT=5080
POSTGRES_PORT=5432
