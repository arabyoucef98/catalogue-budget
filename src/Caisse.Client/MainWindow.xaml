<Window x:Class="Caisse.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caisse réseau" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <TextBlock Text="CAISSE" FontSize="26" FontWeight="Bold" DockPanel.Dock="Left"/>
      <TextBlock x:Name="UserText" Text="Non connecté" Foreground="Gray"
                 VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </DockPanel>
    <Border Grid.Row="1" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6"
            Padding="12" Margin="0,16,0,12">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Utilisateur" VerticalAlignment="Center"/>
        <TextBox x:Name="UsernameBox" Width="110" Text="admin" Margin="8,0,8,0"/>
        <PasswordBox x:Name="PasswordBox" Width="140" Margin="0,0,8,0"/>
        <Button x:Name="LoginButton" Content="Connexion" Width="100" Click="Login_Click" Margin="0,0,24,0"/>
        <TextBlock Text="Article / scan" VerticalAlignment="Center"/>
        <TextBox x:Name="CodeBox" Width="180" Margin="8,0,8,0" KeyDown="CodeBox_KeyDown"/>
        <TextBlock Text="Quantité" VerticalAlignment="Center"/>
        <TextBox x:Name="QuantityBox" Width="60" Text="1" Margin="8,0,8,0"/>
        <Button x:Name="AddButton" Content="Ajouter" Width="90" Click="Add_Click" IsEnabled="False"/>
        <Button x:Name="RefreshButton" Content="Actualiser" Width="90" Click="Refresh_Click"
                IsEnabled="False" Margin="8,0,0,0"/>
      </WrapPanel>
    </Border>
    <DataGrid x:Name="LinesGrid" Grid.Row="2" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
        <DataGridTextColumn Header="Désignation" Binding="{Binding Designation}" Width="*"/>
        <DataGridTextColumn Header="Qté" Binding="{Binding Quantity, StringFormat=N0}" Width="70"/>
        <DataGridTextColumn Header="Prix unitaire" Binding="{Binding UnitPrice, StringFormat=N2}" Width="110"/>
        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="110"/>
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6"
            Padding="12" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="RemoveButton" Content="Retirer la ligne" Width="120"
                Click="Remove_Click" IsEnabled="False"/>
        <TextBlock Grid.Column="1" Text="Paiement" VerticalAlignment="Center" Margin="12,0,6,0"/>
        <ComboBox x:Name="PaymentBox" Grid.Column="2" Width="110" SelectedIndex="0"
                  SelectionChanged="Payment_Changed">
          <ComboBoxItem Content="Espèces"/>
          <ComboBoxItem Content="Carte"/>
          <ComboBoxItem Content="Chèque"/>
        </ComboBox>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,0,12,0">
          <TextBlock Text="Reçu" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="ReceivedBox" Width="95" Text="0" TextChanged="Received_Changed"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <StackPanel>
            <TextBlock x:Name="TotalText" Text="Total : 0,00 DZD" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="ChangeText" Text="Monnaie : 0,00 DZD" Foreground="DarkGreen"/>
          </StackPanel>
          <Button x:Name="ValidateButton" Content="Valider la vente" Width="145"
                  Height="42" Margin="18,0,0,0" Click="Validate_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
